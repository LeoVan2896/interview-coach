# Interview Coach Production Configuration
# Copy this file to .env and replace placeholders with real values before deploying

# PostgreSQL Configuration
# Change these to strong, unique values in production
DB_NAME=interviewdb
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# pgAdmin Configuration
# Change these to your admin credentials
PGADMIN_EMAIL=admin@interview-coach.local
PGADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Anthropic Claude API Key (REQUIRED)
# Get from: https://console.anthropic.com/account/api-keys
# This is essential for the application to function
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_YOUR_ACTUAL_KEY
